FrameWidgetClass KPK_Root {
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass Dim {
   ignorepointer 1
   color 0 0 0 0.65
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style rover_sim_colorable
  }
  FrameWidgetClass Device {
   position 0 0
   size 0.9 0.9
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    PanelWidgetClass Screen {
     color 0.022 0.05 0.03 1
     position 0.2 0.2
     size 0.6 0.6
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     clipchildren 1
     style rover_sim_colorable
    }
    ImageWidgetClass Art {
     ignorepointer 1
     position 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     stretch 1
    }
   }
  }
 }
}
